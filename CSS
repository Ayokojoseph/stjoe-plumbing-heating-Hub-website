body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f4f7f9;
    color: #333;
}

header {
    text-align: center;
    padding: 50px 20px;
    background: #0b4f8a;
    color: white;
}

header h1 {
    font-size: 35px;
}

.btn {
    display: inline-block;
    margin: 10px;
    padding: 12px 20px;
    background: white;
    color: #0b4f8a;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

.whatsapp {
    background: #25D366;
    color: white;
}

section {
    background: white;
    margin: 20px;
    padding: 25px;
    border-radius: 10px;
}

h2 {
    color: #0b4f8a;
}

.services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 20px;
}

.services div {
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

footer {
    text-align: center;
    padding: 20px;
    background: #222;
    color: white;
}
